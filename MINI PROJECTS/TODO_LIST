<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link rel="stylesheet" href="style.css">
</head>
<body>
    <h5>To-Do List</h5>
    <input type="text" placeholder="Create your tasks" id="inp"> 
    <button onclick="addTasks()"> Add Your Task</button>
    <ul id="taskList"></ul>
    <script src="index.js"></script>
</body>
</html>

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f4f7f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 50px;
    margin: 0;
}
h5 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 20px;
}
#inp {
    padding: 10px 15px;
    font-size: 1rem;
    border: 2px solid #ccc;
    border-radius: 5px;
    width: 250px;
    outline: none;
}
button {
    padding: 10px 15px;
    font-size: 1rem;
    background-color: #2ecc71;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-left: 5px;
}
button:hover {
    background-color: #27ae60;
}
#taskList {
    list-style-type: none;
    padding: 0;
    width: 330px;
    margin-top: 30px;
}
li {
    background-color: rgb(216, 200, 200);
    padding: 12px 15px;
    margin-bottom: 10px;
    border-radius: 50px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    font-size: 1.1rem;
    color: #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Style the specific delete button inside the list item */
.numTask {
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    padding: 0;
    margin: 0;
}

.numTask:hover {
    transform: scale(1.2);
}


function addTasks(){
    const newTask=document.getElementById("inp").value;
    const newLi=document.createElement("li");
    newLi.innerHTML=`${newTask} <button class="numTask">❌</button>`;
    const deleteBtn=newLi.querySelector(".numTask");
    deleteBtn.onclick=()=>{
        newLi.remove();
    };
     document.getElementById("taskList").appendChild(newLi);
     document.getElementById("inp").value="";
    }
